{
  "uid": "tiendaonline-logs",
  "title": "TiendaOnline - Logs",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "traceId",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Logs por minuto según servicio",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (app) (count_over_time({app=~\"servicio-.*\"}[1m]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Logs por minuto según nivel",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({app=~\"servicio-.*\"}[1m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Warnings y errores",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=~\"servicio-.*\", level=~\"WARN|ERROR\"} | json | line_format \"{{.app}} {{.level}} [{{.traceId}}] {{.message}}\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Seguir un trace: logs de los 3 servicios (filtrá con la variable traceId)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=~\"servicio-.*\"} |= \"$traceId\" | json | line_format \"{{.app}} {{.level}} [{{.traceId}}] {{.logger_name}} - {{.message}}\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending" }
    }
  ]
}
